FROM node:22-alpine
WORKDIR /app

ARG SERVICE_NAME

# Install deps using lockfile (cached layer)
COPY package.json package-lock.json tsconfig.json ./

# Only copy workspace manifests (not full sources) so npm can resolve workspaces.
COPY libs/shared/package.json ./libs/shared/package.json
COPY services/*/package.json ./services/

RUN npm ci

# Now copy ONLY the sources required at runtime
COPY libs/shared/src ./libs/shared/src
COPY services/${SERVICE_NAME}/src ./services/${SERVICE_NAME}/src

ENV NODE_ENV=production
ENV SERVICE_NAME=$SERVICE_NAME

CMD ["sh", "-c", "node --import tsx services/$SERVICE_NAME/src/main.ts"]

